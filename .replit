modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "resource-scale-regressions"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "continuum-types"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "continuum-browser"

[[workflows.workflow]]
name = "resource-scale-regressions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox test && pnpm --filter @workspace/mockup-sandbox run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "continuum-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/continuum typecheck && pnpm --filter @workspace/continuum test:typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "continuum-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/continuum test"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
